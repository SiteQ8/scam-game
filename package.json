{
  "name": "scam-swipe-game",
  "private": true,
  "version": "1.1.0",
  "description": "A free swipe game in Arabic and English that trains people to spot scams in texts, calls, emails, chats, web pages and QR codes. Offline, with no ads and no account.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "content": "node scripts/validate-content.mjs && node scripts/build-content.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "npm run content && vite build",
    "build:site": "npm run build && node scripts/build-site.mjs",
    "test": "vitest run",
    "check": "tsc --noEmit -p tsconfig.json",
    "brand": "node scripts/apply-brand.mjs"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@fontsource-variable/alexandria": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@preact/signals": "2.11.3",
    "lucide-static": "^1.58.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@capacitor/android": "8.5.3",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@preact/preset-vite": "2.10.6",
    "jsdom": "^26.0.0",
    "qrcode": "1.5.4",
    "typescript": "^5.9.0",
    "vite": "7.3.7",
    "vitest": "^3.2.0"
  }
}
